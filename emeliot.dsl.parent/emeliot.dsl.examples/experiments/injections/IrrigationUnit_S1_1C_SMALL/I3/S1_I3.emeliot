model S1_I3:
 
 specification
 	components : 
	 	Component1	 ports : 	
	 		port c1_in INPUT 
	 		port c1_out OUTPUT  
	 		
	 	Component2	 ports : 	
	 		port c2_in INPUT 
	 		port c2_out OUTPUT

	 	
	 
 	//TO BE DISCUSSED 	  
 time_series :
 	ts_c1 path "experiments/IrrigationUnit_S1_1C_SMALL/irrigationUnit1.txt"
	ts_c2 path "experiments/IrrigationUnit_S1_1C_SMALL/irrigationUnit2.txt"

 injection s1 {
 	var times = getAllTimes(inTS)
 	var values = getAllValues(inTS)
 	if (times.size != values.size) {
 		System.out.println("ERRORE")
 	 	return
 	}
 	var predecessor = values.get(0);
	for(var i=0; i<values.size;i++)
		if(predecessor != values.get(i)){
			System.out.println("TEMPO " + times.get(i) + "VALORE" + values.get(i));
			removeTimeValue(inTS, times.get(i), values.get(i))
			return
		}
 }


config:
	inj s1 port 'C1_in' timeSeries ts_c1
	inj s1 port 'C2_in' timeSeries ts_c2


simultation_platfrom: proteus
project_file: "experiments/S1_BIG/component.pdsprj" 